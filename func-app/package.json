{
  "name": "func-app",
  "version": "0.1.0",
  "private": true,
  "description": "func — phone-first. TypeScript domain, versioned persistence, React Native shell.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/__tests__/*.test.ts'",
    "test:watch": "node --import tsx --test --watch 'src/**/__tests__/*.test.ts'"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.11",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.11",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
